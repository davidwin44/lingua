// Icon, manifest and version information for Lingua.exe
1 ICON "assets/lingua.ico"
1 24 "lingua.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,3
PRODUCTVERSION 0,1,0,3
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "davidwin44"
      VALUE "FileDescription", "Lingua"
      VALUE "FileVersion", "0.1.0-alpha.3"
      VALUE "InternalName", "lingua"
      VALUE "LegalCopyright", "Copyright (c) 2026 davidwin44. All rights reserved."
      VALUE "OriginalFilename", "Lingua.exe"
      VALUE "ProductName", "Lingua"
      VALUE "ProductVersion", "0.1.0-alpha.3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
